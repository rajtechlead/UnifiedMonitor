# ── UniMonitor Environment Configuration ─────────────────────────────────────
# Copy this file to .env and fill in your values

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-string
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://unimonitor:changeme@localhost:5432/unimonitor
POSTGRES_DB=unimonitor
POSTGRES_USER=unimonitor
POSTGRES_PASSWORD=changeme
DB_ECHO=false

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ── Microsoft Entra ID (Azure AD) ─────────────────────────────────────────────
# Your Azure AD tenant ID
ENTRA_TENANT_ID=your-tenant-id-here
# App registration client ID with Graph API permissions
ENTRA_CLIENT_ID=your-client-id-here
# App registration client secret
ENTRA_CLIENT_SECRET=your-client-secret-here
# Redirect URI for OAuth2 callback
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# ── Azure OpenAI (AI Remediation) ────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── SMTP Notifications ────────────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=unimonitor@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=unimonitor@yourdomain.com
SMTP_TLS=true

# ── Reporting ─────────────────────────────────────────────────────────────────
REPORTS_DIR=/app/reports
REPORTS_RETENTION_DAYS=90

# ── OSINT Integrations (optional) ────────────────────────────────────────────
HIBP_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# ── Telemetry (optional) ──────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=unimonitor
