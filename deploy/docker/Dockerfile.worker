# Celery worker image
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[production]"

COPY unimonitor/ ./unimonitor/
COPY controls/ ./controls/
COPY alembic/ ./alembic/
COPY alembic.ini ./

RUN useradd -m -u 1000 appuser && chown -R appuser /app
USER 1000

CMD ["celery", "-A", "unimonitor.worker.celery_app", "worker", \
     "--loglevel=info", \
     "-Q", "assessments,reports,notifications,maintenance", \
     "--concurrency=4"]
