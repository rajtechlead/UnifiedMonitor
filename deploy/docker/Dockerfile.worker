# Celery worker image
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The package must exist before pip runs, or the wheel is empty and the image
# silently relies on the later source copy.
COPY pyproject.toml README.md ./
COPY unimonitor/ ./unimonitor/
RUN pip install --no-cache-dir .

COPY controls/ ./controls/
COPY alembic/ ./alembic/
COPY alembic.ini ./

RUN useradd -m -u 1000 appuser && chown -R appuser /app
USER 1000

CMD ["celery", "-A", "unimonitor.worker.celery_app", "worker", \
     "--loglevel=info", \
     "-Q", "assessments,reports,notifications,maintenance", \
     "--concurrency=4"]
