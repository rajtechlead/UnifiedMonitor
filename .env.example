# ============================================================
# UniMonitor – Environment Configuration
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# ── Application ─────────────────────────────────────────────
UNIMONITOR_ENV=production
UNIMONITOR_DEBUG=false
UNIMONITOR_SECRET_KEY=CHANGE_ME_to_a_64_char_random_string
UNIMONITOR_ALLOWED_HOSTS=["*"]
UNIMONITOR_CORS_ORIGINS=["http://localhost:3000","https://your-domain.com"]

# ── Database ─────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://unimonitor:CHANGE_ME@localhost:5432/unimonitor
DATABASE_SYNC_URL=postgresql+psycopg2://unimonitor:CHANGE_ME@localhost:5432/unimonitor
# SQLite (standalone – uncomment to use)
# DATABASE_URL=sqlite+aiosqlite:///./unimonitor.db
# DATABASE_SYNC_URL=sqlite:///./unimonitor.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Microsoft Entra ID / Graph API ───────────────────────────
# Default tenant (can be overridden per-tenant in DB)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your-client-secret-here
ENTRA_AUTHORITY=https://login.microsoftonline.com
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
GRAPH_API_VERSION=v1.0

# ── Admin bootstrap ──────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com

# ── Telemetry ────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=unimonitor

# ── Reporting ────────────────────────────────────────────────
REPORT_STORAGE_PATH=./reports
REPORT_LOGO_PATH=./branding/logo.png

# ── AI Remediation ───────────────────────────────────────────
# Optional: Azure OpenAI for enhanced AI-powered remediation
AI_ENABLED=false
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com
AZURE_OPENAI_API_KEY=your-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── OSINT Integrations ───────────────────────────────────────
HIBP_API_KEY=your-hibp-key
VIRUSTOTAL_API_KEY=your-vt-key
SHODAN_API_KEY=your-shodan-key

# ── Notifications ────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=unimonitor@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=unimonitor@yourdomain.com

TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
